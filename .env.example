# Vorlage fuer .env -- kopieren und ausfuellen:
#   cp .env.example .env
#
# Hier steht nur, was GEHEIM ist oder sich pro RECHNER unterscheidet.
# Alles, was beeinflusst, was die Probanden hoeren und sehen (Stimmen,
# stability/similarity, Modell-IDs, Whisper-Modellgroesse, beam_size),
# steht bewusst in config.py: die .env ist gitignored, ihre Werte tauchen
# in keinem Commit auf und waeren spaeter nicht mehr rekonstruierbar.
#
# Jede Variable hier ist OPTIONAL -- ohne Eintrag greift der Default aus
# config.py. Ausgenommen die Zugaenge: ohne die geht der jeweilige Dienst
# nicht.

# --- Zugaenge ----------------------------------------------------------

# ElevenLabs: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Hugging Face (LLM im Test-Chat /chat): https://huggingface.co/settings/tokens
HF_TOKEN=

# Google Cloud TTS: nur noetig, wenn KEIN
# `gcloud auth application-default login` gemacht wurde. Dann Pfad zum
# Service-Account-JSON eintragen (relativ = relativ zum Projektordner).
# GOOGLE_APPLICATION_CREDENTIALS=

# --- Umgebung ----------------------------------------------------------

# Externe Umfrage (Godspeed/METI). {participant_number} wird ersetzt.
# Leer = Feature inaktiv.
SURVEY_URL_TEMPLATE=

# TTS-Anbieter beim Serverstart: elevenlabs | google
# Auf dem Entwicklungsrechner "google" spart ElevenLabs-Credits. Im Versuch
# entscheidet ohnehin das Control-Panel, nicht dieser Startwert.
# TTS_PROVIDER=elevenlabs

# Rechengeraet fuer die Spracherkennung: auto | cpu | cuda
# "auto" (Default) schaut selbst nach, ob eine CUDA-GPU da ist -- normal
# braucht es hier keinen Eintrag. Nur setzen, um die Erkennung zu
# ueberstimmen, z.B. "cpu" zum Vergleichen.
# STT_DEVICE=auto

# Ablage der Studiendaten (SQLite). Default: data/study.db im Projektordner.
# Fuer Pilot- und Testlaeufe umlenken, damit die echte Erhebungsdatei
# sauber bleibt.
# STUDY_DB_PATH=data/pilot.db

# --- Nur fuer Tests ----------------------------------------------------

# ElevenLabs-Basis-URL umbiegen, z.B. auf einen lokalen Mock-Server, um
# den TTS-Pfad ohne echte Credits zu testen.
# ELEVENLABS_API_BASE=http://127.0.0.1:8799/v1
